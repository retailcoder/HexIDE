<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HexIDE.Forms.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="140"
             x:DataType="vm:ServerPromptDialogViewModel"
             x:Class="HexIDE.Forms.Views.ServerPromptDialog">
    <StackPanel Margin="16" Spacing="12" MaxWidth="480">
        <!-- The server's words, as it wrote them. -->
        <SelectableTextBlock Text="{CompiledBinding Message}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <ItemsControl ItemsSource="{CompiledBinding Choices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ServerPromptChoice">
                        <Button Content="{CompiledBinding Title}" Command="{CompiledBinding Choose}" MinWidth="84" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{DynamicResource Str.Dialog.ServerPrompt.Close}" Command="{CompiledBinding CloseCommand}"
                    IsVisible="{CompiledBinding HasNoChoices}" MinWidth="84" />
        </StackPanel>
    </StackPanel>
</UserControl>
